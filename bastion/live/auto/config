#!/bin/sh
# live-build configuration for Bastion Linux. Invoked by `lb config`;
# the BASTION_* variables are exported by bastion/build.sh.
set -e

: "${BASTION_VERSION:=1.0}"
: "${BASTION_DIST:=trixie}"
: "${BASTION_KERNEL_FLAVOUR:=amd64}"
: "${BASTION_SECURE_BOOT:=auto}"

# Runtime hardening flags shared by the live system and installed system.
HARDEN="slab_nomerge init_on_alloc=1 page_alloc.shuffle=1 randomize_kstack_offset=on vsyscall=none"

lb config noauto \
	--mode debian \
	--distribution "$BASTION_DIST" \
	--architecture amd64 \
	--archive-areas "main contrib non-free-firmware" \
	--debootstrap-options "--variant=minbase" \
	--apt-recommends false \
	--security true \
	--updates true \
	--cache-packages true \
	--linux-packages linux-image \
	--linux-flavours "$BASTION_KERNEL_FLAVOUR" \
	--firmware-chroot false \
	--firmware-binary false \
	--debian-installer live \
	--debian-installer-gui false \
	--uefi-secure-boot "$BASTION_SECURE_BOOT" \
	--chroot-squashfs-compression-type zstd \
	--chroot-squashfs-compression-level 19 \
	--memtest none \
	--win32-loader false \
	--zsync false \
	--image-name bastion \
	--iso-application "Bastion Linux $BASTION_VERSION" \
	--iso-publisher "Bastion Linux" \
	--iso-volume "BASTION_$(echo "$BASTION_VERSION" | tr . _)" \
	--bootappend-live "boot=live components quiet hostname=bastion username=bastion $HARDEN" \
	--bootappend-install "quiet $HARDEN" \
	"${@}"
