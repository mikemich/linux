#!/bin/sh
# Brand the system as Bastion Linux. ID stays "debian" so every Debian-aware
# tool keeps working; the os-release VARIANT fields carry our identity.
set -e

BASTION_VERSION=1.0
[ -r /live-build/config/bastion.env ] && . /live-build/config/bastion.env

dpkg-divert --quiet --local --rename --divert /usr/lib/os-release.debian \
	--add /usr/lib/os-release
. /usr/lib/os-release.debian

cat > /usr/lib/os-release <<EOT
PRETTY_NAME="Bastion Linux $BASTION_VERSION ($VERSION_CODENAME)"
NAME="Bastion Linux"
VERSION_ID="$VERSION_ID"
VERSION="$BASTION_VERSION ($VERSION_CODENAME)"
VERSION_CODENAME=$VERSION_CODENAME
ID=debian
VARIANT="Bastion"
VARIANT_ID=bastion
HOME_URL="https://github.com/mikemich/linux"
BUG_REPORT_URL="https://github.com/mikemich/linux/issues"
EOT

echo bastion > /etc/hostname
