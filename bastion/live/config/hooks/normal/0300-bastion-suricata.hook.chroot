#!/bin/sh
# Ship Suricata ready to alert on first boot: low-memory detection profile,
# Community ID for SIEM correlation, and ET Open rules baked into the image.
set -e

YAML=/etc/suricata/suricata.yaml
sed -i 's/^\(  profile: \)medium$/\1low/' "$YAML"
sed -i 's/^\(\s*community-id: \)false$/\1true/' "$YAML"

RULES=/var/lib/suricata/rules/suricata.rules
suricata-update --no-test --no-reload || true
# suricata-update exits 0 even when the download fails, so check for ET rules.
if ! grep -q 'msg:"ET ' "$RULES" 2>/dev/null; then
	echo "WARNING: ET Open rules were not downloaded; the image ships only" \
		"Suricata's built-in rules until bastion-daily or 'bastion update' runs" >&2
fi
rm -rf /var/lib/suricata/update/cache/*

# Fail the build on a broken config or ruleset.
if [ -s "$RULES" ]; then
	suricata -T -c "$YAML" -l /tmp
fi
